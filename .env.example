# ===========================================
# CFO INTELIGENTE - Variables de Entorno
# ===========================================
# Copiar a .env y completar con valores reales:
# cp .env.example .env
# --- BASE DE DATOS ---
POSTGRES_USER=cfo_user
POSTGRES_PASSWORD=tu_password_seguro
# Test: cfo_inteligente | Producción: cfo_inteligente_prod
POSTGRES_DB=cfo_inteligente
# --- BACKEND ---
# Generar con: openssl rand -hex 32
SECRET_KEY=generar_con_openssl_rand_hex_32
ANTHROPIC_API_KEY=sk-ant-api03-tu-clave-aqui
# --- MAIL (Resend) ---
RESEND_API_KEY=re_tu-api-key-aqui
# Opcionales (tienen default en config.py):
# EMAIL_REMITENTE=CFO Inteligente <onboarding@resend.dev>
# EMAIL_RESUMEN_ACTIVIDAD=destinatario@dominio.com
ENVIRONMENT=production
# --- CORS ---
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173
# --- FRONTEND ---
VITE_API_URL=http://localhost:8000
